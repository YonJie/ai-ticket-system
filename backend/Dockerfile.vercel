# Vercel Services 容器入口（与 Dockerfile 保持一致）
# 构建阶段：Maven 打包
FROM maven:3.9.9-eclipse-temurin-8 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests package \
    && cp target/ai-ticket-backend-*.jar /build/app.jar

# 运行阶段：使用 Ubuntu Jammy JRE（避免 alpine 镜像中 java 不在 PATH 的问题）
FROM eclipse-temurin:8-jre-jammy
WORKDIR /app
COPY --from=build /build/app.jar /app/app.jar

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
ENV PORT=8080

EXPOSE 8080

# 使用绝对路径启动；Vercel / 容器平台会注入 PORT
CMD ["bash", "-lc", "exec \"${JAVA_HOME}/bin/java\" -jar /app/app.jar --server.port=\"${PORT:-8080}\""]
