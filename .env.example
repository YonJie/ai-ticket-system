# Neon / Spring Boot 数据源与 JWT（部署与本地共用）
# 本地：放在仓库根目录，backend 启动时会自动加载

# 推荐：JDBC URL **不要**把 user:password 写进主机部分（PG JDBC 会把密码误当成端口）
DATABASE_URL=jdbc:postgresql://HOST/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_password

# 也可只配一条 Neon/libpq 串（代码会自动拆成 JDBC URL + username/password）：
# DATABASE_URL=postgresql://neondb_owner:your_password@HOST/neondb?sslmode=require

# JWT 签名密钥（生产环境请使用足够长的随机值）
JWT_SECRET=change-me-to-a-long-random-secret

# 可选：JWT 过期毫秒数（默认 24h）
# JWT_EXPIRATION_MS=86400000

# DeepSeek：创建工单时生成分类 + AI 建议回复（可选；未配置则用规则回退）
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_TIMEOUT_MS=8000

# --- 拆分形式（与上面等价）---
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=your_password
