# Neon / Spring Boot 数据源与 JWT（部署与本地共用）

# Spring Boot 需要 JDBC URL（注意 jdbc: 前缀）
DATABASE_URL=jdbc:postgresql://HOST/neondb?sslmode=require

# JWT 签名密钥（生产环境请使用足够长的随机值）
JWT_SECRET=change-me-to-a-long-random-secret

# 可选：JWT 过期毫秒数（默认 24h）
# JWT_EXPIRATION_MS=86400000

# --- 以下为拆分形式备选（当前 application.properties 主要使用 DATABASE_URL）---
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=your_password
